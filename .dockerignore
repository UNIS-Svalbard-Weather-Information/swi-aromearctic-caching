# Ignore Python-specific files and directories
__pycache__/
*.py[cod]
*$py.class

# Ignore environment files
.env
.env.local

# Ignore version control directories
.git/
.gitignore

# Ignore IDE-specific files
.idea/
.vscode/
*.swp
*.swo

# Ignore build and distribution directories
build/
dist/

# Ignore dependency directories
dependencies/

# Ignore local development files
*.log
*.sqlite

# Ignore Docker-specific files (if not needed in the image)
Dockerfile
.dockerignore

# Ignore virtual environment directories
venv/
.venv/
.env/

# Ignore tool caches and CI configuration
.ruff_cache/
.pytest_cache/
.github/

# Ignore macOS-specific files
.DS_Store

# Ignore Windows-specific files
Thumbs.db
